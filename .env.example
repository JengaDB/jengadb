MODE=mock
ENABLE_MOTION=false
ALLOW_CLOUD=false
MACHINE_ADDRESS=
API_KEY_ID=
API_KEY=
MONGODB_URI=
MONGODB_DATABASE=hackathon
MONGODB_COLLECTION=attempts
# RGB-D collection pipeline (SKY-66). Names only; never commit values.
MACHINE_AUTH=apikey            # none is accepted only for a loopback MACHINE_ADDRESS (local viam-server on this Mac)
SETUP_ID=robot-wrist-d435      # or mac-desk-d435; separate calibration registry and index filter per setup
CAMERA_RESOURCE=cam
CAMERA_SERIAL=                 # e.g. from the module log; recorded in observation.camera.serial
META_API_KEY=                  # Meta Model API (https://api.meta.ai/v1), model sam-3.1
META_API_BASE_URL=https://api.meta.ai
MONGO_DB_MODELS_ENDPOINT_URL=ai.mongodb.com
MONGO_DB_MODELS_ENDPOINT_KEY=  # hosted Voyage key; VOYAGE_API_KEY is accepted as an alias
RGBD_OBSERVATIONS_COLLECTION=observations
RGBD_CANDIDATES_COLLECTION=candidates
BLOCK_DIMENSIONS_MM=75,25,15
BLOCK_DIMENSIONS_VERIFIED=false
MEDIA_ATTEMPT_MAX_AGE_HOURS=24
# Offline proposal agent (AGENT-01). Optional; only the --coordinator openai path uses these.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=                  # empty = placeholder default pending review
